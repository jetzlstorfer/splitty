{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 100,
      "maxConcurrentRequests": 20
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Information",
      "Function": "Warning"
    },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" },
      "enableDependencyTracking": false,
      "enableLiveMetricsFilters": true
    }
  }
}
