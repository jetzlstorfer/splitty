// Workspace transformation that removes sensitive data from Application Insights telemetry
// before it is stored. It runs inside Azure Monitor, so it also covers telemetry generated by
// the Functions host (request URLs, exception messages) that application code never sees.
//
// Transformation KQL has no replace_regex, so values are truncated (URLs) or replaced as a
// whole (free text) instead of being edited in place. KQL is written without backslashes so
// Bicep does not treat any of it as escape sequences.

@description('Name of the data collection rule.')
param name string

@description('Must equal the workspace location.')
param location string

param workspaceId string

// Truncate at the query string, and at the "(" that starts a Table REST key predicate.
func stripUrl(column string) string => '${column} = tostring(split(tostring(split(${column}, "?")[0]), "(")[0])'

// Credential-bearing query parameters, 43-character base64url tokens (session, invitation and
// device secrets) and e-mail addresses.
func redactText(column string) string => '${column} = iif(${column} matches regex "[?&](code|state|id_token|access_token|refresh_token|token|sig|key|password|secret)=" or ${column} matches regex "[A-Za-z0-9_-]{43}" or ${column} matches regex "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}", "[redacted]", ${column})'

func redactDynamic(column string) string => '${column} = iif(tostring(${column}) matches regex "[?&](code|state|id_token|access_token|refresh_token|token|sig|key|password|secret)=" or tostring(${column}) matches regex "[A-Za-z0-9_-]{43}" or tostring(${column}) matches regex "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}", parse_json("null"), ${column})'

var destinationName = 'workspace'

var flows = [
  {
    stream: 'Microsoft-Table-AppRequests'
    kql: 'source | extend ${stripUrl('Url')}'
  }
  {
    stream: 'Microsoft-Table-AppTraces'
    kql: 'source | extend ${redactText('Message')}'
  }
  {
    stream: 'Microsoft-Table-AppExceptions'
    kql: 'source | extend ${redactText('OuterMessage')} | extend ${redactText('InnermostMessage')} | extend ${redactDynamic('Details')}'
  }
  {
    stream: 'Microsoft-Table-AppDependencies'
    kql: 'source | extend ${stripUrl('Data')} | extend ${stripUrl('Name')}'
  }
]

resource rule 'Microsoft.Insights/dataCollectionRules@2023-03-11' = {
  name: name
  location: location
  kind: 'WorkspaceTransforms'
  properties: {
    destinations: {
      logAnalytics: [
        {
          name: destinationName
          workspaceResourceId: workspaceId
        }
      ]
    }
    dataFlows: [for flow in flows: {
      streams: [flow.stream]
      destinations: [destinationName]
      transformKql: flow.kql
    }]
  }
}

output id string = rule.id
